    <string name="intro_title">O GeoStamp é uma câmera</string>
    <string name="intro_body">Ele tira fotos e grava vídeos com a data, a hora e o local escritos neles. Permita a câmera para começar. As fotos ficam no seu telefone.</string>
    <string name="intro_camera_blocked">O acesso à câmera está desativado para o GeoStamp. Abra as configurações do app, escolha Permissões e permita a Câmera.</string>
    <string name="location_offer_title">Adicionar a localização às suas fotos?</string>
    <string name="location_offer_body">A localização é opcional. Com ela, o GeoStamp pode escrever as coordenadas de GPS e o endereço nas suas fotos. A câmera funciona sem ela.</string>
    <string name="location_allow">Permitir localização</string>
    <string name="location_use_precise">Usar localização exata</string>
    <string name="location_turn_on">Ativar localização</string>
    <string name="not_now">Agora não</string>
    <string name="close">Fechar</string>
    <string name="location_help_denied_title">A localização está desativada</string>
    <string name="location_help_denied_body">As fotos são salvas sem coordenadas de GPS. Permita a localização para adicionar o local aos seus carimbos.</string>
    <string name="location_help_blocked_body">O Android não vai perguntar de novo. Abra as configurações do app, escolha Permissões, depois Localização, e selecione \"Permitir durante o uso do app\".</string>
    <string name="location_help_off_title">A localização do telefone está desativada</string>
    <string name="location_help_off_body">Ative a localização nas configurações do telefone para que o GeoStamp saiba onde você está.</string>
    <string name="location_help_approx_title">Localização aproximada</string>
    <string name="location_help_approx_body">O GeoStamp só tem a localização aproximada, que pode errar por um quilômetro ou mais. As coordenadas são marcadas como aproximadas. Permita a localização exata para posições precisas.</string>
    <string name="location_help_searching_title">Procurando sua localização</string>
    <string name="location_help_searching_body">O GPS funciona melhor ao ar livre ou perto de uma janela. Até haver uma posição, as fotos são salvas sem coordenadas. As coordenadas nunca são inventadas.</string>
