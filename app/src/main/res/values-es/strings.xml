    <string name="intro_title">GeoStamp es una cámara</string>
    <string name="intro_body">Hace fotos y vídeos con la fecha, la hora y el lugar escritos encima. Permite el acceso a la cámara para empezar. Las fotos se quedan en tu teléfono.</string>
    <string name="intro_camera_blocked">El acceso a la cámara está desactivado para GeoStamp. Abre los ajustes de la aplicación, elige Permisos y permite la Cámara.</string>
    <string name="location_offer_title">¿Añadir la ubicación a tus fotos?</string>
    <string name="location_offer_body">La ubicación es opcional. Con ella, GeoStamp puede escribir las coordenadas GPS y la dirección en tus fotos. La cámara funciona sin ella.</string>
    <string name="location_allow">Permitir ubicación</string>
    <string name="location_use_precise">Usar ubicación precisa</string>
    <string name="location_turn_on">Activar ubicación</string>
    <string name="not_now">Ahora no</string>
    <string name="close">Cerrar</string>
    <string name="location_help_denied_title">La ubicación está desactivada</string>
    <string name="location_help_denied_body">Las fotos se guardan sin coordenadas GPS. Permite la ubicación para añadir el lugar a tus sellos.</string>
    <string name="location_help_blocked_body">Android no volverá a preguntar. Abre los ajustes de la aplicación, elige Permisos, luego Ubicación, y selecciona \"Mientras se usa la aplicación\".</string>
    <string name="location_help_off_title">La ubicación del teléfono está desactivada</string>
    <string name="location_help_off_body">Activa la ubicación en los ajustes del teléfono para que GeoStamp sepa dónde estás.</string>
    <string name="location_help_approx_title">Ubicación aproximada</string>
    <string name="location_help_approx_body">GeoStamp solo tiene la ubicación aproximada, que puede fallar por un kilómetro o más. Las coordenadas se marcan como aproximadas. Permite la ubicación precisa para obtener posiciones exactas.</string>
    <string name="location_help_searching_title">Buscando tu ubicación</string>
    <string name="location_help_searching_body">El GPS funciona mejor al aire libre o cerca de una ventana. Hasta tener una posición, las fotos se guardan sin coordenadas. Las coordenadas nunca se inventan.</string>
