    <string name="intro_body">It takes photos and videos with the date, time and place written on them. Allow the camera to start. Photos stay on your phone.</string>
    <string name="intro_camera_blocked">Camera access is turned off for GeoStamp. Open app settings, choose Permissions, then allow Camera.</string>
    <string name="location_offer_title">Add location to your photos?</string>
    <string name="location_offer_body">Location is optional. With it, GeoStamp can write GPS coordinates and the address on your photos. The camera works without it.</string>
