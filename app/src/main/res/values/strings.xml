    <!-- Privacy policy -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_intro">GeoStamp is designed to be privacy-focused. It works without an account, shows no ads and keeps your photos on your device.</string>
    <string name="privacy_policy_updated">Last updated: 10 October 2026</string>
    <string name="privacy_data_title">Data collection</string>
    <string name="privacy_data_body">GeoStamp does not require an account and does not intentionally collect personal data. Your settings are stored only on this device and are excluded from cloud backup.</string>
    <string name="privacy_ads_title">Advertising</string>
    <string name="privacy_ads_body">GeoStamp does not display advertisements and contains no advertising SDKs.</string>
    <string name="privacy_tracking_title">Tracking</string>
    <string name="privacy_tracking_body">GeoStamp does not include advertising trackers, behavioral analytics, telemetry or crash-reporting SDKs.</string>
    <string name="privacy_camera_title">Camera</string>
    <string name="privacy_camera_body">Camera permission is used to capture photos and videos. Images are processed on this device.</string>
    <string name="privacy_location_title">Location</string>
    <string name="privacy_location_body">Location permission is used to obtain coordinates, accuracy, direction and address information for location stamps. Location is used only while the camera is open, never in the background. The camera works without it.</string>
    <string name="privacy_microphone_title">Microphone</string>
    <string name="privacy_microphone_body">Microphone access is only used when recording video with audio. Without it, videos are recorded silently.</string>
    <string name="privacy_storage_title">Photo storage</string>
    <string name="privacy_storage_body">Captured photos and videos are saved on your device in Pictures/GeoStamp and Movies/GeoStamp. They remain on your device unless you explicitly share or export them.</string>
    <string name="privacy_exif_title">EXIF metadata</string>
    <string name="privacy_exif_body">If \"Save GPS in photo metadata\" is on, coordinates are written into each photo\'s EXIF metadata. This setting is off by default, and while it is off GeoStamp removes GPS tags from the photos it saves.\n\nLocation metadata and visible stamps can reveal where a photo was taken. Check your photos before sharing them.</string>
    <string name="privacy_maps_title">Map thumbnails</string>
    <string name="privacy_maps_body">If map thumbnails are on, GeoStamp downloads map tiles around your position from the provider of the selected map type: OpenStreetMap for Normal and Hybrid, OpenTopoMap for Terrain, and EOX for Satellite and Hybrid. These requests reveal your approximate location and your IP address to that provider. Tiles are cached on your device for up to 7 days. You can turn map thumbnails off in Settings.</string>
    <string name="privacy_weather_title">Weather</string>
    <string name="privacy_weather_body">If Weather on stamps is on, your coordinates, rounded to about 100 metres, are sent to Open-Meteo (open-meteo.com) to fetch current conditions. Weather is off by default.</string>
    <string name="privacy_geocoding_title">Reverse geocoding</string>
    <string name="privacy_geocoding_body">If Address lookup is on, your current coordinates are sent to your phone\'s built-in geocoding service to turn them into an address. On most Android phones this service is provided by Google. You can turn Address lookup off and type an address yourself.</string>
    <string name="privacy_sharing_title">Sharing</string>
    <string name="privacy_sharing_body">GeoStamp never uploads photos or videos automatically. Sharing happens only when you choose Share. Opening a location in a map app passes its coordinates to that app. Location QR codes are created on your device and contain only a map link with the coordinates.</string>
    <string name="privacy_credits_title">Map credits</string>
