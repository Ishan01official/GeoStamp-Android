    <string name="intro_title">GeoStamp एक कैमरा ऐप है</string>
    <string name="intro_body">यह फ़ोटो और वीडियो पर तारीख, समय और जगह लिख देता है। शुरू करने के लिए कैमरे की अनुमति दें। फ़ोटो आपके फ़ोन पर ही रहती हैं।</string>
    <string name="intro_camera_blocked">GeoStamp के लिए कैमरा अनुमति बंद है। ऐप सेटिंग खोलें, अनुमतियाँ चुनें और कैमरा की अनुमति दें।</string>
    <string name="location_offer_title">फ़ोटो में जगह जोड़ें?</string>
    <string name="location_offer_body">जगह की अनुमति वैकल्पिक है। इससे GeoStamp आपकी फ़ोटो पर GPS निर्देशांक और पता लिख सकता है। कैमरा इसके बिना भी काम करता है।</string>
    <string name="location_allow">जगह की अनुमति दें</string>
